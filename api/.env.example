NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://expense_app:change-me@localhost:5432/expense_tracker
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
CURSOR_SIGNING_SECRET=replace-with-a-different-32-character-random-secret
JWT_ISSUER=expense-tracker-api
JWT_AUDIENCE=expense-tracker-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
WEB_ORIGINS=http://localhost:5173
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
